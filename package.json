{
  "name": "@amaretto-software-labs/cobalt-cli",
  "version": "0.1.0",
  "description": "Official command-line interface for Cobalt.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amaretto-Software-Labs/cobalt-cli.git"
  },
  "homepage": "https://github.com/Amaretto-Software-Labs/cobalt-cli#readme",
  "bugs": {
    "url": "https://github.com/Amaretto-Software-Labs/cobalt-cli/issues"
  },
  "bin": {
    "cobalt": "./dist/main.js"
  },
  "files": [
    "dist",
    "openapi/v1.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:check": "node scripts/check-openapi-parity.mjs",
    "package:npm": "node scripts/package-npm.mjs",
    "pack:check": "pnpm build && node scripts/package-npm.mjs && node scripts/check-package-metadata.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p . --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm openapi:check && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "jose": "^6.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "cobalt",
    "cli",
    "coding-agent",
    "developer-tools"
  ]
}
